#!/bin/bash
# Lokal Web Scraper Launcher Shortcut

# Get the absolute path to this script's directory
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Activate the python virtual environment
if [ -d "$DIR/.venv" ]; then
    source "$DIR/.venv/bin/activate"
else
    echo "Error: Python virtual environment not found in $DIR/.venv"
    echo "Please run setup first."
    exit 1
fi

# Change directory to the workspace root
cd "$DIR"

# Check if port 8000 is already in use
if lsof -Pi :8000 -sTCP:LISTEN -t >/dev/null ; then
    echo "Warning: Port 8000 is already in use."
    echo "Opening http://127.0.0.1:8000 directly..."
    open "http://127.0.0.1:8000" 2>/dev/null || xdg-open "http://127.0.0.1:8000"
    exit 0
fi

# Function to stop the server on script exit
cleanup() {
    echo ""
    echo "Stopping Lokal Web Scraper..."
    kill $UVICORN_PID 2>/dev/null
    exit 0
}

# Trap Ctrl+C (SIGINT) and terminal exit (SIGTERM)
trap cleanup SIGINT SIGTERM

# Start Uvicorn backend in the background
echo "Starting Lokal Web Scraper backend server on http://127.0.0.1:8000..."
python -m uvicorn main:app --port 8000 --host 127.0.0.1 > /dev/null 2>&1 &
UVICORN_PID=$!

# Wait briefly for server startup
sleep 1.2

# Open browser to the dashboard URL
echo "Opening dashboard in your browser..."
if command -v open >/dev/null 2>&1; then
    open "http://127.0.0.1:8000"
elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "http://127.0.0.1:8000"
else
    echo "Could not auto-open browser. Please go to http://127.0.0.1:8000"
fi

echo "Lokal Web Scraper is running. Press [CTRL+C] to stop the server."

# Keep launcher script alive to monitor the server
wait $UVICORN_PID
